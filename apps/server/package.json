{
  "name": "@skb/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local Hono server for Manuscript: API, vault, database and (later) agent.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts --dev --vault ../../.dev-vault --data-dir ../../.dev-data",
    "build": "node ../../scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@skb/core": "0.1.0",
    "chokidar": "5.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-types": "0.24.8",
    "hono": "4.13.13",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
